        "jsCode": " // Une ligne par agent → 3 items → le nœud Postgres fera 3 INSERT\n  const pr = $('Filter').first().json.body;\n  const agents = ['Qualité', 'Sécurité', 'Tests'];\n    \n  return agents.map(agent => {\n    const r = $('Agent ' + agent).first().json;\n    return {\n      json: {\n        repo: pr.repository.full_name,\n        pr_number: pr.pull_request.number,\n        agent,\n        resultat: r.merged_response,\n        prompt_tokens: r.usage.input_tokens,\n        completion_tokens: r.usage.output_tokens,\n      },\n    };\n  });    "
      },
