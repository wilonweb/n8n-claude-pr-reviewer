      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst item = $input.first();\nconst secret = $env.GITHUB_WEBHOOK_SECRET;\nconst headers = item.json.headers || {};\nconst signature = headers['x-hub-signature-256'] || '';\nconst event = headers['x-github-event'];\n\n// Pas de body brut (ex : test manuel avec données épinglées) → on rejette au lieu de planter\nif (!item.binary || !item.binary.data) {\n  return [{ json: { valid: false, event, body: item.json.body } }];\n}\n\n// Body brut (option Raw Body du Webhook) — la signature est calculée dessus, pas sur le JSON reparsé\nconst rawBody = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(rawBody).digest('hex');\n\n// Comparaison à temps constant (évite les attaques par mesure de temps)\nconst a = Buffer.from(signature);\nconst b = Buffer.from(expected);\nconst valid = a.length === b.length && crypto.timingSafeEqual(a, b);\n\nreturn [{ json: { valid, event, body: item.json.body } }];"
      },
