    {
      "parameters": {
        "jsCode": "// Limites pour ne pas exploser le contexte du LLM\nconst MAX_PER_FILE = 3000;\nconst MAX_TOTAL = 20000;\n\nconst files = $input.all().map(i => i.json);\n\nlet diff = '';\nlet truncated = false;\nconst skipped = [];\n\nfor (const f of files) {\n  // Pas de patch = fichier binaire ou trop gros côté GitHub\n  if (!f.patch) {\n    skipped.push(f.filename);\n    continue;\n  }\n\n  let patch = f.patch;\n  if (patch.length > MAX_PER_FILE) {\n    patch = patch.slice(0, MAX_PER_FILE) + '\\n[... tronqué]';\n    truncated = true;\n  }\n\n  const block = `### ${f.filename} (${f.status})\\n${patch}\\n\\n`;\n\n  if (diff.length + block.length > MAX_TOTAL) {\n    diff += '[... diff total tronqué, fichiers suivants ignorés]\\n';\n    truncated = true;\n    break;\n  }\n  diff += block;\n}\n\nreturn [{\n  json: {\n    diff,\n    files_count: files.length,\n    truncated,\n    skipped,\n  },\n}];"
      },
