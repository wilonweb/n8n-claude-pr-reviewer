        "jsCode": "  // Récupère la réponse de chaque agent par son NOM de nœud (d'où l'importance de la majuscule)\n  const qualite  = $('Agent Qualité').first().json.merged_response;\n  const securite = $('Agent Sécurité').first().json.merged_response;\n  const tests    = $('Agent Tests').first().json.merged_response;\n    \n  const comment = [\n    '<!-- pr-review-bot -->',      // marqueur invisible pour retrouver notre commentaire\n    '## 🤖 Review automatique',\n    '### 🧹 Qualité',\n    qualite,\n    '### 🔒 Sécurité',\n    securite,\n    '### 🧪 Tests',\n    tests,\n  ].join('\\n\\n'); \n\n  // UN seul item en sortie → un seul POST\n  return [{ json: { comment } }];"
