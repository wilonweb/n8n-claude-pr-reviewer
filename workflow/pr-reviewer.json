        "jsCode": "  const MARQUEUR = '<!-- pr-review-bot -->'; \n\n  // Tous les commentaires renvoyés par GitHub (1 item = 1 commentaire ; {} si aucun)\n  const commentaires = $input.all().map(item => item.json);\n      \n  // Le nôtre = celui dont le texte (body) contient le marqueur\n  const existant = commentaires.find(c => typeof c.body === 'string' && c.body.includes(MARQUEUR));\n     \n  return [{\n    json: {\n      comment: $('Assemblage').first().json.comment,  // le texte de la review (pas dans $json ici !)\n      commentId: existant ? existant.id : null,         // id si trouvé, sinon null → POST\n    }\n  }];"
